<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: catches com.chintan.app://auth/callback?... (error fallback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.chintan.app" android:host="auth" />
            </intent-filter>

            <!-- Verified App Link: catches https://<domain>/auth/callback?... from the
                 OAuth relay. autoVerify makes Android check /.well-known/assetlinks.json
                 so only this app (matching the signing cert) can claim the URL. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="chintangithubio-production.up.railway.app"
                      android:pathPrefix="/auth/callback" />
            </intent-filter>

            <!-- Verified App Link: shared story URLs, www.chintan.news/article/ID.
                 Without this, a shared link had no way back into the app even
                 when installed. Android had no reason to route the domain
                 anywhere but a browser, which then 404'd because the marketing
                 site had no /article route at all.

                 www ONLY, deliberately. The apex 308-redirects to www, and
                 Android does not follow redirects when fetching
                 assetlinks.json, so chintan.news can never verify. One failing
                 host fails the whole autoVerify filter, which would take www
                 down with it. Shares point at www too (see SHARE_BASE).
                 Verification reads /.well-known/assetlinks.json, served from
                 chintan-website/public/.well-known. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.chintan.news" android:pathPrefix="/article" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
